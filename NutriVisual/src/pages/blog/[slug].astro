---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';
import foodsData from '../../data/foods.json';
import SocialShare from '../../components/SocialShare.astro';
import { buildBreadcrumbSchema, buildArticleSchema } from '../../utils/schemaBuilder';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} - NutriVisual Blog`;
const description = post.data.subtitle;
const canonicalUrl = `https://nutrivisual.com/blog/${post.id}/`;

const relatedFoodIds = post.data.relatedFoods || [];
const relatedFoods = foodsData.filter(f => relatedFoodIds.includes(f.id));

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://nutrivisual.com/' },
  { name: 'Blog', url: 'https://nutrivisual.com/blog/' },
  { name: post.data.title, url: canonicalUrl }
]);
const articleSchema = buildArticleSchema({
  title: post.data.title,
  description: post.data.subtitle,
  url: canonicalUrl,
  authorName: 'NutriVisual Editorial Team'
});
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8MPE6XWC1E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8MPE6XWC1E');
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Previews -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD Structured Data for Blog Post & Breadcrumb -->
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    {post.data.youtubeId && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "VideoObject",
        "name": post.data.title,
        "description": post.data.subtitle,
        "thumbnailUrl": [
          `https://img.youtube.com/vi/${post.data.youtubeId}/hqdefault.jpg`
        ],
        "embedUrl": `https://www.youtube-nocookie.com/embed/${post.data.youtubeId}`,
        "uploadDate": "2026-07-22"
      })} />
    )}

    <!-- Early Theme Script to prevent flash -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <!-- Top Navigation Header -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-main);">
          <span style="font-size: 1.6rem;">🥑</span>
          <span style="font-weight: 700; font-size: 1.3rem; letter-spacing: -0.5px;">Nutri<span style="color: var(--accent-green);">Visual</span></span>
        </a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">☰</button>
        <nav class="header-nav" id="header-nav">
          <a href="/" style="color: var(--accent-green); font-weight: 600;">← Home</a>
          <a href="/swap/">Food Swaps</a>
          <a href="/blog/" style="color: var(--accent-green); font-weight: 600;">Blog</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <button id="theme-toggle" aria-label="Toggle theme" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem; font-weight: 600; box-shadow: var(--shadow-card); transition: all 0.2s ease;">
            <span id="theme-icon">☀️</span> <span id="theme-text">Light</span>
          </button>
        </nav>
      </div>
    </header>

    <!-- Main Container -->
    <main class="container" style="padding-top: 3rem; padding-bottom: 5rem; max-width: 800px; line-height: 1.7;">
      <article>
        <!-- Breadcrumb Navigation -->
        <nav style="font-size: 0.85rem; margin-bottom: 1.5rem; color: var(--text-muted);" aria-label="Breadcrumb">
          <a href="/" style="color: var(--text-muted); text-decoration: none;">Home</a> / <a href="/blog/" style="color: var(--text-muted); text-decoration: none;">Blog</a> / <span style="color: var(--accent-green);">{post.data.title}</span>
        </nav>

        <!-- Category Badge -->
        <span style="display: inline-block; background-color: var(--accent-green-glow); color: var(--accent-green); font-size: 0.78rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 6px; margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">
          {post.data.category}
        </span>

        <h1 style="font-size: 2.2rem; font-weight: 700; line-height: 1.25; margin-bottom: 0.5rem; color: var(--text-main);">
          {post.data.title}
        </h1>

        <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 1.5rem; font-style: italic; line-height: 1.5;">
          {post.data.subtitle}
        </p>

        <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 2.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
          Published on {post.data.date} • Written by John & Mary • {post.data.readTime}
        </div>

        {post.data.youtubeId && (
          <div class="video-container" style="position: relative; width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 16px; margin-bottom: 2.5rem; box-shadow: var(--shadow-card, 0 8px 30px rgba(0,0,0,0.12)); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); background: #000;">
            <iframe 
              src={`https://www.youtube-nocookie.com/embed/${post.data.youtubeId}`}
              title={`YouTube video: ${post.data.title}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen 
              style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;"
            />
          </div>
        )}

        <div class="markdown-body" style="font-size: 1.05rem; color: var(--text-main); display: flex; flex-direction: column; gap: 1.5rem;">
          <Content />
        </div>

        <SocialShare title={post.data.title} url={canonicalUrl} description={post.data.subtitle} />

        {relatedFoods.length > 0 && (
          <div class="glass-card" style="margin-top: 3.5rem; padding: 2rem; background-color: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-color);">
            <h3 style="font-size: 1.3rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.5rem; text-align: center; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
              📊 Interactive Portion & Macro Visualizer
            </h3>
            <p style="color: var(--text-muted); font-size: 0.88rem; text-align: center; margin-bottom: 1.5rem;">
              Adjust the slider to see how calories and macros scale in real-time for the foods discussed in this article.
            </p>

            {relatedFoods.length > 1 && (
              <div style="display: flex; gap: 0.5rem; justify-content: center; margin-bottom: 1.8rem; flex-wrap: wrap;">
                {relatedFoods.map((food, idx) => (
                  <button 
                    class="food-tab-btn"
                    data-food-id={food.id}
                    style={idx === 0 
                      ? "background: var(--accent-green); border: 1px solid var(--accent-green); color: white; padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; font-weight: 600; transition: all 0.2s ease;" 
                      : "background: var(--bg-surface); border: 1px solid var(--border-color); color: var(--text-muted); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; font-weight: 600; transition: all 0.2s ease;"
                    }
                  >
                    {food.name}
                  </button>
                ))}
              </div>
            )}

            {relatedFoods.map((food, idx) => (
              <div class="food-visualizer-section" id={`viz-${food.id}`} style={idx === 0 ? "display: block;" : "display: none;"}>
                <div style="text-align: center; margin-bottom: 1.5rem;">
                  <span style="font-size: 0.9rem; color: var(--text-muted); font-weight: 600;">Portion Size:</span>
                  <span id={`weight-val-${food.id}`} style="font-size: 1.4rem; font-weight: 800; color: var(--accent-green); margin-left: 0.3rem;">100g</span>
                </div>

                <input 
                  type="range" 
                  min="10" 
                  max="300" 
                  value="100" 
                  class="portion-slider" 
                  data-food-id={food.id}
                  data-base-calories={food.calories}
                  data-base-protein={food.macros.protein}
                  data-base-carbs={food.macros.carbs}
                  data-base-fat={food.macros.fat}
                  style="width: 100%; margin-bottom: 2rem; accent-color: var(--accent-green); cursor: pointer;"
                />

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                  <div style="background: var(--bg-surface); padding: 1rem; border-radius: 12px; border: 1px solid var(--border-color); text-align: center;">
                    <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Calories</div>
                    <div id={`calories-${food.id}`} style="font-size: 1.6rem; font-weight: 800; color: var(--text-main); margin-top: 0.25rem;">{food.calories}</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">kcal</div>
                  </div>
                  <div style="background: var(--bg-surface); padding: 1rem; border-radius: 12px; border: 1px solid var(--border-color); text-align: center;">
                    <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Protein</div>
                    <div id={`protein-${food.id}`} style="font-size: 1.6rem; font-weight: 800; color: var(--accent-green); margin-top: 0.25rem;">{food.macros.protein}g</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">build & repair</div>
                  </div>
                  <div style="background: var(--bg-surface); padding: 1rem; border-radius: 12px; border: 1px solid var(--border-color); text-align: center;">
                    <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Carbs</div>
                    <div id={`carbs-${food.id}`} style="font-size: 1.6rem; font-weight: 800; color: var(--text-main); margin-top: 0.25rem;">{food.macros.carbs}g</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">energy fuel</div>
                  </div>
                  <div style="background: var(--bg-surface); padding: 1rem; border-radius: 12px; border: 1px solid var(--border-color); text-align: center;">
                    <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Fat</div>
                    <div id={`fat-${food.id}`} style="font-size: 1.6rem; font-weight: 800; color: var(--text-main); margin-top: 0.25rem;">{food.macros.fat}g</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted);">cellular health</div>
                  </div>
                </div>

                <div style="background: var(--bg-surface); padding: 1rem; border-radius: 12px; border: 1px solid var(--border-color); margin-top: 1rem;">
                  <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 0.5rem; text-align: center;">Target Longevity Pathways</div>
                  <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap;">
                    {food.benefits.map(benefit => (
                      <span style="font-size: 0.78rem; background-color: var(--accent-green-glow); color: var(--accent-green); padding: 0.25rem 0.65rem; border-radius: 12px; font-weight: 600;">
                        🛡️ {benefit}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}

        <!-- High-Contrast Call to Action Card -->
        <div class="glass-card" style="margin-top: 4rem; padding: 2rem; border-left: 5px solid var(--accent-green); background-color: var(--bg-card);">
          <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.75rem;">
            📊 Run the Visual Analytics for this Article
          </h3>
          <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.5;">
            {post.data.cta.text}
          </p>
          <a href={post.data.cta.url} style="display: inline-block; background-color: var(--accent-green); color: white; padding: 0.65rem 1.35rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 0.9rem; transition: opacity 0.2s ease;">
            Interactive Engine Dashboard →
          </a>
        </div>
      </article>
    </main>

    <!-- Footer -->
    <footer style="margin-top: 5rem; border-top: 1px solid var(--border-color); padding: 2rem 0; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
      <div class="container">
        <p>&copy; 2026 NutriVisual. All rights reserved.</p>
        <div style="margin-top: 0.5rem; display: flex; justify-content: center; gap: 1rem;">
          <a href="/privacy/" style="color: var(--text-muted); text-decoration: none;">Privacy Policy</a>
          <a href="/terms/" style="color: var(--text-muted); text-decoration: none;">Terms of Service</a>
          <a href="/disclaimer/" style="color: var(--text-muted); text-decoration: none;">Medical Disclaimer</a>
        </div>
      </div>
    </footer>

    <!-- Mobile Hamburger Toggle Script -->
    <script is:inline>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const nav = document.getElementById('header-nav');
      if (menuBtn && nav) {
        menuBtn.addEventListener('click', () => {
          nav.classList.toggle('active');
          menuBtn.textContent = nav.classList.contains('active') ? '✕' : '☰';
        });
      }

      // Theme toggle functionality
      const themeToggle = document.getElementById('theme-toggle');
      const themeIcon = document.getElementById('theme-icon');
      const themeText = document.getElementById('theme-text');

      function updateThemeUI(theme) {
        if (themeIcon && themeText) {
          themeIcon.textContent = theme === 'dark' ? '🌙' : '☀️';
          themeText.textContent = theme === 'dark' ? 'Dark' : 'Light';
        }
      }

      const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
      updateThemeUI(currentTheme);

      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', t);
          localStorage.setItem('theme', t);
          updateThemeUI(t);
        });
      }

      // Tab selector logic for food visualizer
      const tabButtons = document.querySelectorAll('.food-tab-btn');
      const sections = document.querySelectorAll('.food-visualizer-section');
      
      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          tabButtons.forEach(b => {
            b.style.background = 'var(--bg-surface)';
            b.style.borderColor = 'var(--border-color)';
            b.style.color = 'var(--text-muted)';
          });
          btn.style.background = 'var(--accent-green)';
          btn.style.borderColor = 'var(--accent-green)';
          btn.style.color = 'white';

          const foodId = btn.getAttribute('data-food-id');
          sections.forEach(sec => {
            sec.style.display = sec.id === `viz-${foodId}` ? 'block' : 'none';
          });
        });
      });

      // Portion slider logic
      const sliders = document.querySelectorAll('.portion-slider');
      sliders.forEach(slider => {
        slider.addEventListener('input', (e) => {
          const val = parseInt(e.target.value);
          const foodId = e.target.getAttribute('data-food-id');
          const ratio = val / 100;

          const baseCal = parseFloat(e.target.getAttribute('data-base-calories'));
          const baseProt = parseFloat(e.target.getAttribute('data-base-protein'));
          const baseCarbs = parseFloat(e.target.getAttribute('data-base-carbs'));
          const baseFat = parseFloat(e.target.getAttribute('data-base-fat'));

          document.getElementById(`weight-val-${foodId}`).textContent = `${val}g`;
          document.getElementById(`calories-${foodId}`).textContent = Math.round(baseCal * ratio);
          document.getElementById(`protein-${foodId}`).textContent = `${(baseProt * ratio).toFixed(1)}g`;
          document.getElementById(`carbs-${foodId}`).textContent = `${(baseCarbs * ratio).toFixed(1)}g`;
          document.getElementById(`fat-${foodId}`).textContent = `${(baseFat * ratio).toFixed(1)}g`;
        });
      });
    </script>
  </body>
</html>
