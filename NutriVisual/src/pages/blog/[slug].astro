---
import '../../styles/global.css';
import posts from '../../data/posts.json';

export async function getStaticPaths() {
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

const title = `${post.title} - NutriVisual Blog`;
const description = post.subtitle;
const canonicalUrl = `https://nutrivisual.com/blog/${post.slug}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Previews -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD Structured Data for Blog Post -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": post.title,
      "description": post.subtitle,
      "datePublished": "2026-07-22",
      "author": {
        "@type": "Person",
        "name": "John & Mary"
      },
      "publisher": {
        "@type": "Organization",
        "name": "NutriVisual",
        "url": "https://nutrivisual.com"
      }
    })} />

    <!-- Early Theme Script to prevent flash -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <!-- Top Navigation Header -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-main);">
          <span style="font-size: 1.6rem;">🥑</span>
          <span style="font-weight: 700; font-size: 1.3rem; letter-spacing: -0.5px;">Nutri<span style="color: var(--accent-green);">Visual</span></span>
        </a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">☰</button>
        <nav class="header-nav" id="header-nav">
          <a href="/" style="color: var(--accent-green); font-weight: 600;">← Home</a>
          <a href="/blog/" style="color: var(--accent-green); font-weight: 600;">Blog</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <button id="theme-toggle" aria-label="Toggle theme" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem; font-weight: 600; box-shadow: var(--shadow-card); transition: all 0.2s ease;">
            <span id="theme-icon">☀️</span> <span id="theme-text">Light</span>
          </button>
        </nav>
      </div>
    </header>

    <!-- Main Container -->
    <main class="container" style="padding-top: 3rem; padding-bottom: 5rem; max-width: 800px; line-height: 1.7;">
      <article>
        <!-- Breadcrumb Navigation -->
        <nav style="font-size: 0.85rem; margin-bottom: 1.5rem; color: var(--text-muted);" aria-label="Breadcrumb">
          <a href="/" style="color: var(--text-muted); text-decoration: none;">Home</a> / <a href="/blog/" style="color: var(--text-muted); text-decoration: none;">Blog</a> / <span style="color: var(--accent-green);">{post.title}</span>
        </nav>

        <!-- Category Badge -->
        <span style="display: inline-block; background-color: var(--accent-green-glow); color: var(--accent-green); font-size: 0.78rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 6px; margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">
          {post.category}
        </span>

        <h1 style="font-size: 2.2rem; font-weight: 700; line-height: 1.25; margin-bottom: 0.5rem; color: var(--text-main);">
          {post.title}
        </h1>

        <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 1.5rem; font-style: italic; line-height: 1.5;">
          {post.subtitle}
        </p>

        <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 2.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
          Published on {post.date} • Written by John & Mary • {post.readTime}
        </div>

        <div style="font-size: 1.05rem; color: var(--text-main); display: flex; flex-direction: column; gap: 2rem;">
          {post.sections.map(section => (
            <div>
              <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-main);">
                {section.heading}
              </h2>
              {section.paragraphs.map(p => (
                <p style="margin-bottom: 1.25rem; color: var(--text-main);">
                  {p}
                </p>
              ))}
            </div>
          ))}
        </div>

        <!-- High-Contrast Call to Action Card -->
        <div class="glass-card" style="margin-top: 4rem; padding: 2rem; border-left: 5px solid var(--accent-green); background-color: var(--bg-card);">
          <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.75rem;">
            📊 Run the Visual Analytics for this Article
          </h3>
          <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.5;">
            {post.cta.text}
          </p>
          <a href={post.cta.url} style="display: inline-block; background-color: var(--accent-green); color: white; padding: 0.65rem 1.35rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 0.9rem; transition: opacity 0.2s ease;">
            Interactive Engine Dashboard →
          </a>
        </div>
      </article>
    </main>

    <!-- Footer -->
    <footer style="margin-top: 5rem; border-top: 1px solid var(--border-color); padding: 2rem 0; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
      <div class="container">
        <p>&copy; 2026 NutriVisual. All rights reserved.</p>
        <div style="margin-top: 0.5rem; display: flex; justify-content: center; gap: 1rem;">
          <a href="/privacy/" style="color: var(--text-muted); text-decoration: none;">Privacy Policy</a>
          <a href="/terms/" style="color: var(--text-muted); text-decoration: none;">Terms of Service</a>
          <a href="/disclaimer/" style="color: var(--text-muted); text-decoration: none;">Medical Disclaimer</a>
        </div>
      </div>
    </footer>

    <!-- Mobile Hamburger Toggle Script -->
    <script is:inline>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const nav = document.getElementById('header-nav');
      if (menuBtn && nav) {
        menuBtn.addEventListener('click', () => {
          nav.classList.toggle('active');
          menuBtn.textContent = nav.classList.contains('active') ? '✕' : '☰';
        });
      }

      // Theme toggle functionality
      const themeToggle = document.getElementById('theme-toggle');
      const themeIcon = document.getElementById('theme-icon');
      const themeText = document.getElementById('theme-text');

      function updateThemeUI(theme) {
        if (themeIcon && themeText) {
          themeIcon.textContent = theme === 'dark' ? '🌙' : '☀️';
          themeText.textContent = theme === 'dark' ? 'Dark' : 'Light';
        }
      }

      const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
      updateThemeUI(currentTheme);

      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', t);
          localStorage.setItem('theme', t);
          updateThemeUI(t);
        });
      }
    </script>
  </body>
</html>
