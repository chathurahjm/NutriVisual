---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { buildWebPageSchema, buildBreadcrumbSchema } from '../utils/schemaBuilder';

const title = "Privacy Policy - NutriVisual";
const description = "Privacy Policy for NutriVisual including Google AdSense, cookie usage, third-party analytics, and user privacy protections.";
const canonicalUrl = "https://nutrivisual.com/privacy/";

const webPageSchema = buildWebPageSchema(title, description, canonicalUrl);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://nutrivisual.com/' },
  { name: 'Privacy Policy', url: canonicalUrl }
]);
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8MPE6XWC1E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8MPE6XWC1E');
    </script>
    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y14bl1l18k");
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Rich Snippet Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-main);">
          <span style="font-size: 1.6rem;">🥑</span>
          <span style="font-weight: 700; font-size: 1.3rem; letter-spacing: -0.5px;">Nutri<span style="color: var(--accent-green);">Visual</span></span>
        </a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">☰</button>
        <nav class="header-nav" id="header-nav">
          <a href="/" style="color: var(--accent-green); font-weight: 600;">← Home</a>
          <a href="/swap/">Food Swaps</a>
          <a href="/blog/">Blog</a>
          <button id="theme-toggle" aria-label="Toggle theme" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
            <span id="theme-icon">☀️</span> <span id="theme-text">Light</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="container" style="padding-top: 3rem; padding-bottom: 5rem; max-width: 800px; line-height: 1.7;">
      <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main);">Privacy Policy</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 2.5rem;">Last updated: July 21, 2026</p>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--text-main); margin-bottom: 1rem;">1. Introduction</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem;">
          Welcome to NutriVisual ("we," "our," or "us"), accessible via <strong>https://nutrivisual.com</strong>. We are committed to maintaining the highest standard of privacy protection and transparency. This Privacy Policy details how we handle user privacy, cookie utilization, third-party ad networks, analytics services, and your legal rights regarding data protection.
        </p>
      </div>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--text-main); margin-bottom: 1rem;">2. Information Collection and Usage</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem;">
          NutriVisual does not require user accounts, logins, or personal identification to access our visual nutrition guide and portion calculators. Browsing on NutriVisual is completely anonymous. Like standard web publishers, our servers automatically collect non-personally identifiable information, including IP address, browser user-agent string, operating system type, referring URL, and site navigation patterns for security and performance optimization.
        </p>
      </div>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem; border-left: 4px solid var(--accent-green);">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--text-main); margin-bottom: 1rem;">3. Google AdSense & Third-Party Advertising Policy</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem;">
          NutriVisual is affiliated with Google AdSense and third-party advertising vendors to display relevant advertisements across our website. It is mandatory for publishers to disclose the following Google AdSense privacy terms:
        </p>
        <ul style="color: var(--text-muted); font-size: 0.95rem; margin-left: 1.5rem; margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
          <li><strong>Cookie Utilization:</strong> Google, as a third-party vendor, uses cookies (including the DoubleClick DART cookie) to serve ads based on a user's prior visits to NutriVisual or other websites on the Internet.</li>
          <li><strong>Interest-Based Ads:</strong> Advertising cookies enable Google and its network partners to serve personalized advertisements to users based on web browsing behavior and demographic signals.</li>
          <li><strong>Opting Out of Personalized Advertising:</strong> Users may opt out of personalized advertising at any time by visiting <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" style="color: var(--accent-green); font-weight: 600;">Google Ad Settings</a>.</li>
          <li><strong>Network Opt-Out Resources:</strong> Alternatively, users can opt out of third-party vendor cookie usage for interest-based advertising by visiting <a href="http://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer" style="color: var(--accent-green); font-weight: 600;">aboutads.info</a> or the <a href="https://www.networkadvertising.org/choices/" target="_blank" rel="noopener noreferrer" style="color: var(--accent-green); font-weight: 600;">Network Advertising Initiative Opt-Out Page</a>.</li>
        </ul>
        <button type="button" onclick="window.openCookieConsent && window.openCookieConsent()" style="background: var(--accent-green-glow); color: var(--accent-green); border: 1px solid var(--accent-green); padding: 0.6rem 1.2rem; border-radius: 10px; font-weight: 700; font-size: 0.88rem; cursor: pointer;">⚙️ Manage Cookie Consent Preferences</button>
      </div>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--text-main); margin-bottom: 1rem;">4. Web Analytics & Log Data</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem;">
          We utilize Privacy-Preserving Google Analytics (GA4) to evaluate visitor traffic patterns, aggregate user duration, and improve page load speeds. Google Analytics uses first-party cookies to record anonymized web metrics. No personally identifiable health data or nutritional queries are linked to user identities.
        </p>
      </div>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--text-main); margin-bottom: 1rem;">5. Data Protection Rights (GDPR & CCPA/CPRA)</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem;">
          Under the General Data Protection Regulation (GDPR) and California Consumer Privacy Act (CCPA/CPRA), users possess explicit privacy rights:
        </p>
        <ul style="color: var(--text-muted); font-size: 0.95rem; margin-left: 1.5rem;">
          <li>The right to request information on collected data categories.</li>
          <li>The right to opt-out of data sale or third-party sharing for personalized targeting.</li>
          <li>The right to request non-discrimination for exercising privacy rights.</li>
        </ul>
      </div>

      <div class="glass-card" style="padding: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--text-main); margin-bottom: 1rem;">6. Publisher Contact & Legal Representative</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">
          For inquiries, data requests, or privacy clarifications, contact the NutriVisual Publisher Team directly:<br/>
          <strong style="color: var(--text-main);">Email:</strong> chathurahjm@gmail.com<br/>
          <strong style="color: var(--text-main);">Official Website:</strong> https://nutrivisual.com
        </p>
      </div>
    </main>

    <footer style="border-top: 1px solid var(--border-color); padding: 2rem 0; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
      <div class="container">
        <p>© 2026 NutriVisual. All rights reserved. <a href="/blog/" style="color: var(--accent-green);">Blog</a> | <a href="/terms/" style="color: var(--accent-green);">Terms</a> | <a href="/disclaimer/" style="color: var(--accent-green);">Disclaimer</a> | <button type="button" onclick="window.openCookieConsent && window.openCookieConsent()" style="background: none; border: none; color: var(--accent-green); cursor: pointer; text-decoration: underline; font-size: inherit; font-family: inherit; padding: 0;">Cookie Settings</button></p>
      </div>
    </footer>

    <CookieConsent />

    <script is:inline>
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const text = document.getElementById('theme-text');
        function syncUI(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
          if (icon && text) {
            icon.textContent = theme === 'light' ? '☀️' : '🌙';
            text.textContent = theme === 'light' ? 'Light' : 'Dark';
          }
        }
        syncUI(localStorage.getItem('theme') || 'light');
        if (btn) btn.onclick = () => syncUI(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      }
      function initMobileMenu() { const menuBtn = document.getElementById("mobile-menu-btn"); const nav = document.getElementById("header-nav"); if (menuBtn && nav) { menuBtn.onclick = () => { nav.classList.toggle("open"); menuBtn.textContent = nav.classList.contains("open") ? "✕" : "☰"; }; } } initThemeToggle(); initMobileMenu();
    </script>
  </body>
</html>
