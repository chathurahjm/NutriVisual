---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { buildWebPageSchema, buildBreadcrumbSchema } from '../utils/schemaBuilder';

const title = "Medical & Nutrition Disclaimer - NutriVisual";
const description = "Medical and nutritional disclaimer for NutriVisual educational reference materials.";
const canonicalUrl = "https://nutrivisual.com/disclaimer/";

const webPageSchema = buildWebPageSchema(title, description, canonicalUrl);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://nutrivisual.com/' },
  { name: 'Medical Disclaimer', url: canonicalUrl }
]);
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8MPE6XWC1E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8MPE6XWC1E');
    </script>
    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y14bl1l18k");
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Rich Snippet Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-main);">
          <span style="font-size: 1.6rem;">🥑</span>
          <span style="font-weight: 700; font-size: 1.3rem; letter-spacing: -0.5px;">Nutri<span style="color: var(--accent-green);">Visual</span></span>
        </a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">☰</button>
        <nav class="header-nav" id="header-nav">
          <a href="/" style="color: var(--accent-green); font-weight: 600;">← Home</a>
          <a href="/swap/">Food Swaps</a>
          <a href="/blog/">Blog</a>
          <button id="theme-toggle" aria-label="Toggle theme" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
            <span id="theme-icon">☀️</span> <span id="theme-text">Light</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="container" style="padding-top: 3rem; padding-bottom: 5rem; max-width: 800px; line-height: 1.7;">
      <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main);">Medical & Nutrition Disclaimer</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 2.5rem;">Last updated: July 21, 2026</p>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem; border-left: 4px solid var(--accent-green);">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--text-main); margin-bottom: 1rem;">1. Educational & Scientific Reference Purpose Only</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
          All information published on NutriVisual—including macronutrient charts, micronutrient density scores, satiety index metrics, visual portion scaling tools, and editorial articles—is created exclusively for educational and informational reference purposes. NutriVisual does not evaluate individual clinical health status or prescribe therapeutic medical diets.
        </p>
      </div>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--text-main); margin-bottom: 1rem;">2. No Physician or Dietitian Relationship Created</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
          Content on NutriVisual must never be interpreted as personal medical advice, clinical diagnosis, or individualized treatment plans. Accessing or interacting with NutriVisual tools does not establish a doctor-patient or dietitian-client relationship. Always consult a qualified physician, registered dietitian, or certified medical professional before implementing significant dietary modifications or managing chronic metabolic conditions.
        </p>
      </div>

      <div class="glass-card" style="padding: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--text-main); margin-bottom: 1rem;">3. Natural Agricultural & Culinary Variance</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
          Nutritional figures displayed on NutriVisual are based on reference standards from the USDA FoodData Central database. However, actual nutritional values in raw or prepared foods naturally vary due to soil quality, seasonal harvesting, agricultural origin, cooking temperatures, moisture content loss, and specific commercial product formulations.
        </p>
      </div>
    </main>

    <footer style="border-top: 1px solid var(--border-color); padding: 2rem 0; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
      <div class="container">
        <p>© 2026 NutriVisual. All rights reserved. <a href="/blog/" style="color: var(--accent-green);">Blog</a> | <a href="/terms/" style="color: var(--accent-green);">Terms</a> | <a href="/disclaimer/" style="color: var(--accent-green);">Disclaimer</a> | <button type="button" onclick="window.openCookieConsent && window.openCookieConsent()" style="background: none; border: none; color: var(--accent-green); cursor: pointer; text-decoration: underline; font-size: inherit; font-family: inherit; padding: 0;">Cookie Settings</button></p>
      </div>
    </footer>

    <CookieConsent />

    <script is:inline>
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const text = document.getElementById('theme-text');
        function syncUI(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
          if (icon && text) {
            icon.textContent = theme === 'light' ? '☀️' : '🌙';
            text.textContent = theme === 'light' ? 'Light' : 'Dark';
          }
        }
        syncUI(localStorage.getItem('theme') || 'light');
        if (btn) btn.onclick = () => syncUI(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      }
      function initMobileMenu() { const menuBtn = document.getElementById("mobile-menu-btn"); const nav = document.getElementById("header-nav"); if (menuBtn && nav) { menuBtn.onclick = () => { nav.classList.toggle("open"); menuBtn.textContent = nav.classList.contains("open") ? "✕" : "☰"; }; } } initThemeToggle(); initMobileMenu();
    </script>
  </body>
</html>
