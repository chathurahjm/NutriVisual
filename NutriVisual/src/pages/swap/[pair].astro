---
import '../../styles/global.css';
import CookieConsent from '../../components/CookieConsent.astro';
import foodsData from '../../data/foods.json';
import SocialShare from '../../components/SocialShare.astro';
import { buildNutritionProductSchema, buildBreadcrumbSchema, buildHowToSchema, buildFAQPageSchema } from '../../utils/schemaBuilder';
import { popularPairs } from '../../utils/popularPairs';

export async function getStaticPaths() {
  const paths = [];

  // Generate paths for popular predefined pairs
  popularPairs.forEach(([id1, id2]) => {
    const f1 = foodsData.find(f => f.id === id1);
    const f2 = foodsData.find(f => f.id === id2);
    if (f1 && f2) {
      paths.push({
        params: { pair: `${f1.id}-vs-${f2.id}` },
        props: { food1: f1, food2: f2 }
      });
    }
  });

  // Also auto-generate cross-category top pairs
  const baseFoods = foodsData.slice(0, 25);
  for (let i = 0; i < baseFoods.length; i++) {
    for (let j = i + 1; j < Math.min(i + 4, baseFoods.length); j++) {
      const f1 = baseFoods[i];
      const f2 = baseFoods[j];
      const pairKey = `${f1.id}-vs-${f2.id}`;
      if (!paths.some(p => p.params.pair === pairKey)) {
        paths.push({
          params: { pair: pairKey },
          props: { food1: f1, food2: f2 }
        });
      }
    }
  }

  return paths;
}

const { food1, food2 } = Astro.props;

// Quick-win target custom metadata overrides for high-impression search terms
const pairSlug = `${food1.id}-vs-${food2.id}`;
const customMeta: Record<string, { title: string; description: string }> = {
  'avocado-vs-chia-seeds': {
    title: 'Avocado vs Chia Seeds: Calories, Fiber & Healthy Fats | NutriVisual',
    description: 'Avocado vs chia seeds nutrition & macro comparison (160 kcal vs 486 kcal per 100g). Compare fiber content, monounsaturated vs omega-3 fats, and portion swap ratios.'
  },
  'avocado-oil-vs-olive-oil': {
    title: 'Avocado Oil vs Olive Oil: Macros, Calories & Smoke Point | NutriVisual',
    description: 'Extra virgin avocado oil vs olive oil macro comparison chart. Analyze calories, smoke points, oleic acid, and healthy fat swap ratios per tablespoon & 100g.'
  },
  'macadamia-nuts-vs-olive-oil': {
    title: 'Macadamia Nuts vs Olive Oil: Calories, Fat & Nutrition | NutriVisual',
    description: 'Is macadamia oil healthier than olive oil? Compare calories, healthy monounsaturated fat profiles, and portion swap ratios for macadamia nuts vs olive oil.'
  },
  'flaxseed-vs-olive-oil': {
    title: 'Flaxseed vs Olive Oil: Healthy Fats, Fiber & Macro Swap | NutriVisual',
    description: 'Flaxseed vs olive oil nutrition breakdown. Compare omega-3 ALA, dietary fiber, calorie density, and portion swap metrics.'
  },
  'avocado-vs-walnuts': {
    title: 'Avocado vs Walnuts: Calories, Healthy Fats & Macro Swap | NutriVisual',
    description: 'Avocado vs walnuts macro comparison chart (160 vs 654 kcal per 100g). Compare monounsaturated vs polyunsaturated fats, fiber, and volume eating swap ratios.'
  },
  'greek-yogurt-vs-tofu': {
    title: 'Greek Yogurt vs Tofu: High Protein & Calorie Comparison | NutriVisual',
    description: 'Greek yogurt vs tofu protein & macro comparison. See exact portion visualizer metrics, calories, amino acid profiles, and dietary swap ratios.'
  }
};

const title = customMeta[pairSlug]?.title || `${food1.name} vs ${food2.name}: Calories, Macros & Food Swap | NutriVisual`;
const description = customMeta[pairSlug]?.description || `${food1.name} vs ${food2.name} macro & calorie comparison (${food1.calories} vs ${food2.calories} kcal per 100g). Portion visualizer metrics, protein, fats, and volume eating swap ratios.`;
const canonicalUrl = `https://nutrivisual.com/swap/${pairSlug}/`;

// Swap Ratio Calculation (How much Food 2 equals 100g of Food 1)
const swapGramsFood2 = Math.round((food1.calories / food2.calories) * 100);
const calDiff = Math.abs(food1.calories - food2.calories);
const lowerCalFood = food1.calories <= food2.calories ? food1 : food2;
const higherCalFood = food1.calories > food2.calories ? food1 : food2;

// Build Schema Suite
const food1Schema = buildNutritionProductSchema(food1, `https://nutrivisual.com/food/${food1.id}/`);
const food2Schema = buildNutritionProductSchema(food2, `https://nutrivisual.com/food/${food2.id}/`);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://nutrivisual.com/' },
  { name: 'Food Swaps', url: 'https://nutrivisual.com/swap/' },
  { name: `${food1.name} vs ${food2.name}`, url: canonicalUrl }
]);
const howToSchema = buildHowToSchema(
  `How to Swap ${food1.name} for ${food2.name}`,
  `Step-by-step visual portion calculation to match calories between ${food1.name} and ${food2.name}.`,
  [
    { name: `Measure 100g of ${food1.name}`, text: `100g of ${food1.name} provides ${food1.calories} kcal (${food1.macros.protein}g protein, ${food1.macros.fat}g fat).` },
    { name: `Calculate Swap Quantity`, text: `To match ${food1.calories} kcal of ${food1.name}, serve exactly ${swapGramsFood2}g of ${food2.name}.` }
  ]
);
const faqSchema = buildFAQPageSchema([
  {
    question: `How much ${food2.name} equals 100g of ${food1.name}?`,
    answer: `Exactly ${swapGramsFood2} grams of ${food2.name} equals the total caloric value of 100g of ${food1.name} (${food1.calories} kcal).`
  },
  {
    question: `Which food is lower in calories: ${food1.name} or ${food2.name}?`,
    answer: `${lowerCalFood.name} is lower in calories with ${lowerCalFood.calories} kcal per 100g compared to ${higherCalFood.name} with ${higherCalFood.calories} kcal per 100g.`
  },
  {
    question: `Which has more protein: ${food1.name} or ${food2.name}?`,
    answer: `${food1.macros.protein >= food2.macros.protein ? food1.name : food2.name} provides more protein per 100g (${Math.max(food1.macros.protein, food2.macros.protein)}g vs ${Math.min(food1.macros.protein, food2.macros.protein)}g).`
  }
]);

// Find related food swaps involving food1 or food2 for internal link silos
const relatedSwaps = popularPairs
  .filter(([id1, id2]) => (id1 === food1.id || id2 === food1.id || id1 === food2.id || id2 === food2.id) && `${id1}-vs-${id2}` !== pairSlug)
  .map(([id1, id2]) => {
    const f1 = foodsData.find(f => f.id === id1);
    const f2 = foodsData.find(f => f.id === id2);
    return {
      pairSlug: `${id1}-vs-${id2}`,
      title: `${f1?.name || id1} vs ${f2?.name || id2}`,
      img1: f1?.image || food1.image,
      img2: f2?.image || food2.image
    };
  }).slice(0, 4);
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8MPE6XWC1E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8MPE6XWC1E');
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={food1.image} />
    <meta property="og:type" content="article" />

    <!-- Google Rich Snippet Schemas (Nutrition, Breadcrumbs, HowTo, FAQs) -->
    <script type="application/ld+json" set:html={JSON.stringify([food1Schema, food2Schema])} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Early Theme Script -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <!-- Top Header -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-main);">
          <span style="font-size: 1.6rem;">🥑</span>
          <span style="font-weight: 700; font-size: 1.3rem; letter-spacing: -0.5px;">Nutri<span style="color: var(--accent-green);">Visual</span></span>
        </a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">☰</button>
        <nav class="header-nav" id="header-nav">
          <a href="/" style="color: var(--accent-green); font-weight: 600;">← Home</a>
          <a href="/swap/" style="color: var(--accent-green); font-weight: 600;">Food Swaps</a>
          <a href="/blog/">Blog</a>
          <button id="theme-toggle" aria-label="Toggle theme" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
            <span id="theme-icon">☀️</span> <span id="theme-text">Light</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="container" style="padding-top: 2.5rem; padding-bottom: 5rem;">
      {/* Breadcrumb */}
      <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">
        <a href="/" style="color: var(--text-muted); text-decoration: none;">Home</a> / <a href="/swap/" style="color: var(--text-muted); text-decoration: none;">Swaps</a> / <span style="color: var(--accent-green);">{food1.name} vs {food2.name}</span>
      </div>

      {/* Hero Header */}
      <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem auto;">
        <h1 style="font-size: 2.4rem; font-weight: 700; margin-bottom: 0.75rem; line-height: 1.2;">
          {food1.name} <span style="color: var(--accent-green);">vs</span> {food2.name}
        </h1>
        <p style="color: var(--text-muted); font-size: 1.05rem;">
          Side-by-side nutritional swap analysis for standard <strong>100g reference portions</strong>.
        </p>
      </div>

      {/* Highlights & Swap Ratio Verdict Card */}
      <div class="glass-card" style="padding: 2rem; margin-bottom: 3rem; border-left: 4px solid var(--accent-green);">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
          💡 Swap Takeaway & Calorie Ratio
        </h2>
        <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin: 0 0 1rem 0;">
          Eating <strong>100g of {food1.name}</strong> ({food1.calories} kcal) provides the same calorie intake as eating <strong>{swapGramsFood2}g of {food2.name}</strong>.
          {calDiff > 0 ? ` ${lowerCalFood.name} is ${calDiff} kcal lighter per 100g than ${higherCalFood.name}.` : ' Both foods have identical calorie densities.'}
        </p>
      </div>

      {/* Structured Comparison Data Table for GEO & Search Engines */}
      <div class="glass-card" style="padding: 1.5rem; margin-bottom: 3rem; overflow-x: auto;">
        <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-main);">
          📊 Nutritional Matrix (Per 100g Reference Portion)
        </h3>
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
          <thead>
            <tr style="border-bottom: 2px solid var(--border-color); background: var(--bg-surface);">
              <th style="padding: 0.75rem 1rem; color: var(--text-main);">Nutritional Metric</th>
              <th style="padding: 0.75rem 1rem; color: var(--accent-green);">{food1.name}</th>
              <th style="padding: 0.75rem 1rem; color: var(--accent-cyan);">{food2.name}</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style="padding: 0.75rem 1rem; font-weight: 600;">Calories (kcal)</td>
              <td style="padding: 0.75rem 1rem;">{food1.calories} kcal</td>
              <td style="padding: 0.75rem 1rem;">{food2.calories} kcal</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style="padding: 0.75rem 1rem; font-weight: 600;">Protein (g)</td>
              <td style="padding: 0.75rem 1rem;">{food1.macros.protein} g</td>
              <td style="padding: 0.75rem 1rem;">{food2.macros.protein} g</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style="padding: 0.75rem 1rem; font-weight: 600;">Total Fat (g)</td>
              <td style="padding: 0.75rem 1rem;">{food1.macros.fat} g</td>
              <td style="padding: 0.75rem 1rem;">{food2.macros.fat} g</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style="padding: 0.75rem 1rem; font-weight: 600;">Carbohydrates (g)</td>
              <td style="padding: 0.75rem 1rem;">{food1.macros.carbs} g</td>
              <td style="padding: 0.75rem 1rem;">{food2.macros.carbs} g</td>
            </tr>
            <tr>
              <td style="padding: 0.75rem 1rem; font-weight: 600;">Primary Category</td>
              <td style="padding: 0.75rem 1rem;">{food1.category}</td>
              <td style="padding: 0.75rem 1rem;">{food2.category}</td>
            </tr>
          </tbody>
        </table>
      </div>

      {/* Side by Side Comparison Grid */}
      <div class="layout-swap-cards">
        {/* Food 1 Card */}
        <div class="glass-card" style="padding: 2rem;">
          <div style="border-radius: 12px; overflow: hidden; height: 220px; margin-bottom: 1.25rem; border: 1px solid var(--border-color);">
            <img src={food1.image} alt={food1.name} style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <h3 style="font-size: 1.6rem; font-weight: 700; margin-bottom: 0.25rem;">{food1.name}</h3>
          <div style="color: var(--accent-green); font-size: 0.9rem; font-weight: 600; margin-bottom: 1.5rem;">{food1.category}</div>

          <div class="layout-swap-macros">
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color);">
              <div style="font-size: 0.75rem; color: var(--text-muted);">Cal</div>
              <div style="font-size: 1.1rem; font-weight: 700; font-family: var(--font-mono);">{food1.calories}</div>
            </div>
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color);">
              <div style="font-size: 0.75rem; color: var(--text-muted);">Fat</div>
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--accent-green); font-family: var(--font-mono);">{food1.macros.fat}g</div>
            </div>
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color);">
              <div style="font-size: 0.75rem; color: var(--text-muted);">Carb</div>
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--accent-cyan); font-family: var(--font-mono);">{food1.macros.carbs}g</div>
            </div>
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color);">
              <div style="font-size: 0.75rem; color: var(--text-muted);">Prot</div>
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--accent-amber); font-family: var(--font-mono);">{food1.macros.protein}g</div>
            </div>
          </div>

          <h4 style="font-size: 0.9rem; font-weight: 600; margin-bottom: 0.5rem;">🧬 Key Micronutrients</h4>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
            {Object.entries(food1.micros).map(([k, v]) => (
              <div style="background: var(--bg-surface); padding: 0.35rem 0.65rem; border-radius: 6px; font-size: 0.8rem; border: 1px solid var(--border-color);">
                <span style="color: var(--text-muted); text-transform: capitalize;">{k}:</span> <strong>{v}</strong>
              </div>
            ))}
          </div>

          <a href={`/food/${food1.id}/`} style="display: block; text-align: center; background: var(--bg-surface); border: 1px solid var(--accent-green); color: var(--accent-green); padding: 0.6rem; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.9rem;">
            View Full {food1.name} Profile →
          </a>
        </div>

        {/* Food 2 Card */}
        <div class="glass-card" style="padding: 2rem;">
          <div style="border-radius: 12px; overflow: hidden; height: 220px; margin-bottom: 1.25rem; border: 1px solid var(--border-color);">
            <img src={food2.image} alt={food2.name} style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <h3 style="font-size: 1.6rem; font-weight: 700; margin-bottom: 0.25rem;">{food2.name}</h3>
          <div style="color: var(--accent-green); font-size: 0.9rem; font-weight: 600; margin-bottom: 1.5rem;">{food2.category}</div>

          <div class="layout-swap-macros">
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color);">
              <div style="font-size: 0.75rem; color: var(--text-muted);">Cal</div>
              <div style="font-size: 1.1rem; font-weight: 700; font-family: var(--font-mono);">{food2.calories}</div>
            </div>
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color);">
              <div style="font-size: 0.75rem; color: var(--text-muted);">Fat</div>
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--accent-green); font-family: var(--font-mono);">{food2.macros.fat}g</div>
            </div>
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color);">
              <div style="font-size: 0.75rem; color: var(--text-muted);">Carb</div>
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--accent-cyan); font-family: var(--font-mono);">{food2.macros.carbs}g</div>
            </div>
            <div style="background: var(--bg-surface); padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color);">
              <div style="font-size: 0.75rem; color: var(--text-muted);">Prot</div>
              <div style="font-size: 1.1rem; font-weight: 700; color: var(--accent-amber); font-family: var(--font-mono);">{food2.macros.protein}g</div>
            </div>
          </div>

          <h4 style="font-size: 0.9rem; font-weight: 600; margin-bottom: 0.5rem;">🧬 Key Micronutrients</h4>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
            {Object.entries(food2.micros).map(([k, v]) => (
              <div style="background: var(--bg-surface); padding: 0.35rem 0.65rem; border-radius: 6px; font-size: 0.8rem; border: 1px solid var(--border-color);">
                <span style="color: var(--text-muted); text-transform: capitalize;">{k}:</span> <strong>{v}</strong>
              </div>
            ))}
          </div>

          <a href={`/food/${food2.id}/`} style="display: block; text-align: center; background: var(--bg-surface); border: 1px solid var(--accent-green); color: var(--accent-green); padding: 0.6rem; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.9rem;">
            View Full {food2.name} Profile →
          </a>
        </div>
      </div>

      {/* Frequently Asked Questions (FAQ) Section for SERPs & Voice Search */}
      <section class="glass-card" style="padding: 2.5rem; margin-bottom: 3rem;">
        <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          ❓ Frequently Asked Questions ({food1.name} vs {food2.name})
        </h2>
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div style="background: var(--bg-surface); padding: 1.25rem; border-radius: 10px; border: 1px solid var(--border-color);">
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.5rem 0;">
              How much {food2.name} equals 100g of {food1.name}?
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0; line-height: 1.5;">
              Exactly <strong>{swapGramsFood2} grams of {food2.name}</strong> equals the total caloric value of 100g of {food1.name} ({food1.calories} kcal).
            </p>
          </div>
          <div style="background: var(--bg-surface); padding: 1.25rem; border-radius: 10px; border: 1px solid var(--border-color);">
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.5rem 0;">
              Which food is lower in calories: {food1.name} or {food2.name}?
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0; line-height: 1.5;">
              <strong>{lowerCalFood.name}</strong> is lower in calories with {lowerCalFood.calories} kcal per 100g compared to {higherCalFood.name} with {higherCalFood.calories} kcal per 100g.
            </p>
          </div>
          <div style="background: var(--bg-surface); padding: 1.25rem; border-radius: 10px; border: 1px solid var(--border-color);">
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.5rem 0;">
              Which has more protein: {food1.name} or {food2.name}?
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0; line-height: 1.5;">
              <strong>{food1.macros.protein >= food2.macros.protein ? food1.name : food2.name}</strong> provides more protein per 100g ({Math.max(food1.macros.protein, food2.macros.protein)}g vs {Math.min(food1.macros.protein, food2.macros.protein)}g).
            </p>
          </div>
        </div>
      </section>

      {/* Internal Link Silo: Related Food Swaps Section */}
      {relatedSwaps.length > 0 && (
        <section class="glass-card" style="padding: 2.5rem; margin-bottom: 3rem;">
          <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            🔄 Related Food Swaps & Macro Comparisons
          </h2>
          <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
            Explore related calorie and macro comparisons for <strong>{food1.name}</strong> and <strong>{food2.name}</strong>:
          </p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
            {relatedSwaps.map((swap) => (
              <a href={`/swap/${swap.pairSlug}/`} style="text-decoration: none; color: inherit;">
                <div style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1.25rem; border-radius: 12px; display: flex; align-items: center; gap: 1rem; transition: border-color 0.2s ease, transform 0.2s ease;">
                  <div style="display: flex; align-items: center; gap: 0;">
                    <img src={swap.img1} alt="" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid var(--bg-card);" />
                    <img src={swap.img2} alt="" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid var(--bg-card); margin-left: -14px;" />
                  </div>
                  <div>
                    <h3 style="font-weight: 700; font-size: 0.95rem; color: var(--accent-green); margin: 0 0 0.25rem 0;">{swap.title}</h3>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">View portion swap analysis →</p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <SocialShare title={`${food1.name} vs ${food2.name} - Nutrition Comparison`} url={canonicalUrl} description={description} />
    </main>

    <footer style="border-top: 1px solid var(--border-color); padding: 2.5rem 0; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
      <div class="container">
        <p style="margin-bottom: 0.75rem;">© 2026 NutriVisual. Visual nutrition and longevity reference engine.</p>
        <div style="display: flex; justify-content: center; gap: 1.25rem; flex-wrap: wrap;">
          <a href="/about/" style="color: var(--accent-green); text-decoration: none;">About Us</a>
          <a href="/privacy/" style="color: var(--accent-green); text-decoration: none;">Privacy Policy</a>
          <a href="/terms/" style="color: var(--accent-green); text-decoration: none;">Terms of Service</a>
          <a href="/disclaimer/" style="color: var(--accent-green); text-decoration: none;">Medical Disclaimer</a>
          <a href="/contact/" style="color: var(--accent-green); text-decoration: none;">Contact Us</a>
          <button type="button" onclick="window.openCookieConsent && window.openCookieConsent()" style="background: none; border: none; color: var(--accent-green); cursor: pointer; text-decoration: underline; font-size: inherit; font-family: inherit; padding: 0;">Cookie Settings</button>
        </div>
      </div>
    </footer>

    <CookieConsent />

    <script is:inline>
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const text = document.getElementById('theme-text');
        function syncUI(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
          if (icon && text) {
            icon.textContent = theme === 'light' ? '☀️' : '🌙';
            text.textContent = theme === 'light' ? 'Light' : 'Dark';
          }
        }
        syncUI(localStorage.getItem('theme') || 'light');
        if (btn) btn.onclick = () => syncUI(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      }
      function initMobileMenu() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const nav = document.getElementById('header-nav');
        if (menuBtn && nav) {
          menuBtn.onclick = () => {
            nav.classList.toggle('open');
            menuBtn.textContent = nav.classList.contains('open') ? '✕' : '☰';
          };
        }
      }
      initThemeToggle();
      initMobileMenu();
    </script>
  </body>
</html>
