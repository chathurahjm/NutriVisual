---
import '../styles/global.css';

const title = "About Us - NutriVisual";
const description = "Learn about NutriVisual's mission to bring high-precision visual nutrition and longevity reference data to everyone.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-main);">
          <span style="font-size: 1.6rem;">🥑</span>
          <span style="font-weight: 700; font-size: 1.3rem; letter-spacing: -0.5px;">Nutri<span style="color: var(--accent-green);">Visual</span></span>
        </a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">☰</button>
        <nav class="header-nav" id="header-nav">
          <a href="/" style="color: var(--accent-green); font-weight: 600;">← Home</a>
          <a href="/blog/stomach-digestion-speed/">Blog</a>
          <button id="theme-toggle" aria-label="Toggle theme" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
            <span id="theme-icon">☀️</span> <span id="theme-text">Light</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="container" style="padding-top: 3rem; padding-bottom: 5rem; max-width: 800px; line-height: 1.7;">
      <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main);">About NutriVisual</h1>
      <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 2.5rem;">
        Making nutrition science intuitive, visual, and accessible for optimal health and longevity.
      </p>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--accent-green); margin-bottom: 1rem;">🌱 Our Mission</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">
          NutriVisual was built to solve a simple problem: standard nutrition databases are dense, textual, and hard to contextualize. Our mission is to provide an interactive, visual reference engine that combines lab-tested USDA nutrition data with intuitive portion visualizers and metabolic health insights.
        </p>
      </div>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--accent-green); margin-bottom: 1rem;">🔬 Data Rigor & Precision</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">
          Every food profile on NutriVisual is grounded in scientifically verified figures derived from the U.S. Department of Agriculture (USDA) FoodData Central and the Atwater Specific Factor System. We account for dietary fiber digestibility and metabolizable energy to give you the most accurate calorie and micronutrient breakdown possible.
        </p>
      </div>

      <div class="glass-card" style="padding: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--accent-green); margin-bottom: 1rem;">⚡ Interactive Tools</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem;">
          Whether you are tracking macronutrients for athletic performance, optimizing for longevity, or managing dietary preferences (Keto, Vegan, Low-FODMAP), our dynamic portion sliders and side-by-side comparison matrices provide instant clarity.
        </p>
      </div>
    </main>

    <footer style="border-top: 1px solid var(--border-color); padding: 2rem 0; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
      <div class="container">
        <p>© 2026 NutriVisual. All rights reserved. <a href="/blog/stomach-digestion-speed/" style="color: var(--accent-green);">Blog</a> | <a href="/terms/" style="color: var(--accent-green);">Terms</a> | <a href="/about/" style="color: var(--accent-green);">About</a> | <a href="/contact/" style="color: var(--accent-green);">Contact</a></p>
      </div>
    </footer>

    <script is:inline>
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const text = document.getElementById('theme-text');
        function syncUI(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
          if (icon && text) {
            icon.textContent = theme === 'light' ? '☀️' : '🌙';
            text.textContent = theme === 'light' ? 'Light' : 'Dark';
          }
        }
        syncUI(localStorage.getItem('theme') || 'light');
        if (btn) btn.onclick = () => syncUI(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      }
      function initMobileMenu() { const menuBtn = document.getElementById("mobile-menu-btn"); const nav = document.getElementById("header-nav"); if (menuBtn && nav) { menuBtn.onclick = () => { nav.classList.toggle("open"); menuBtn.textContent = nav.classList.contains("open") ? "✕" : "☰"; }; } } initThemeToggle(); initMobileMenu();
    </script>
  </body>
</html>
