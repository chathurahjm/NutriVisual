---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { buildOrganizationSchema, buildBreadcrumbSchema } from '../utils/schemaBuilder';

const title = "About Us - NutriVisual";
const description = "Learn about NutriVisual's mission to bring high-precision visual nutrition and longevity reference data to everyone.";
const canonicalUrl = "https://nutrivisual.com/about/";

const orgSchema = buildOrganizationSchema();
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://nutrivisual.com/' },
  { name: 'About Us', url: canonicalUrl }
]);
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8MPE6XWC1E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8MPE6XWC1E');
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="NutriVisual" />
    <meta property="og:image" content="https://nutrivisual.com/favicon.svg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://nutrivisual.com/favicon.svg" />

    <!-- Google Rich Snippet Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-main);">
          <span style="font-size: 1.6rem;">🥑</span>
          <span style="font-weight: 700; font-size: 1.3rem; letter-spacing: -0.5px;">Nutri<span style="color: var(--accent-green);">Visual</span></span>
        </a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">☰</button>
        <nav class="header-nav" id="header-nav">
          <a href="/" style="color: var(--accent-green); font-weight: 600;">← Home</a>
          <a href="/swap/">Food Swaps</a>
          <a href="/blog/">Blog</a>
          <button id="theme-toggle" aria-label="Toggle theme" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
            <span id="theme-icon">☀️</span> <span id="theme-text">Light</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="container" style="padding-top: 3rem; padding-bottom: 5rem; max-width: 800px; line-height: 1.7;">
      <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main);">About NutriVisual</h1>
      <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 2.5rem;">
        Making nutrition science intuitive, visual, and accessible for optimal health and longevity.
      </p>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--accent-green); margin-bottom: 1rem;">🌱 Our Mission & Vision</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
          NutriVisual was founded to bridge the gap between complex biochemical nutritional data and practical daily meal choices. Standard nutrition databases present numbers in static text tables that lack visual scale. NutriVisual transforms laboratory nutrition data into an interactive, visual reference engine that translates macronutrients, micronutrient density, and calorie volume into intuitive portion equivalents.
        </p>
      </div>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--accent-green); margin-bottom: 1rem;">🔬 Scientific Data Rigor & USDA Standards</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1rem;">
          Every food item, calorie calculation, and portion ratio featured on NutriVisual is grounded in reference standard data from the <strong>U.S. Department of Agriculture (USDA) FoodData Central</strong> and the <strong>Atwater Specific Factor System</strong>.
        </p>
        <ul style="color: var(--text-muted); font-size: 0.95rem; margin-left: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
          <li><strong>Metabolizable Energy Accounting:</strong> We factor in net dietary fiber digestibility and resistant starch to compute net metabolizable calories accurately.</li>
          <li><strong>Bioavailability Analysis:</strong> Our comparative matrix evaluates micronutrient absorption efficiency, such as heme vs. non-heme iron and fat-soluble vitamin co-factors.</li>
          <li><strong>Standardized Reference Portions:</strong> All primary food profiles are scaled to a lab-tested 100-gram baseline for consistent cross-category comparisons.</li>
        </ul>
      </div>

      <div class="glass-card" style="padding: 2rem; margin-bottom: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--accent-green); margin-bottom: 1rem;">📑 Editorial Process & Medical Review Policy</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1rem;">
          NutriVisual adheres to strict editorial integrity and evidence-based publishing principles:
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
          <div style="background: var(--bg-surface); padding: 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
            <h4 style="font-weight: 700; color: var(--text-main); margin: 0 0 0.4rem 0;">Peer-Reviewed Sources</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">Articles synthesize clinical findings from PubMed, PubMed Central (PMC), and recognized nutritional research journals.</p>
          </div>
          <div style="background: var(--bg-surface); padding: 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
            <h4 style="font-weight: 700; color: var(--text-main); margin: 0 0 0.4rem 0;">No Commercial Bias</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">NutriVisual operates independently without brand sponsorships, pharmaceutical affiliations, or food manufacturer funding.</p>
          </div>
        </div>
      </div>

      <div class="glass-card" style="padding: 2rem;">
        <h2 style="font-size: 1.3rem; font-weight: 600; color: var(--accent-green); margin-bottom: 1rem;">✉️ Editorial Team & Publisher Transparency</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6;">
          NutriVisual is maintained by a dedicated team of nutrition researchers, web developers, and health data specialists.<br/>
          <strong>Publisher Contact:</strong> chathurahjm@gmail.com<br/>
          <strong>Location:</strong> NutriVisual Media & Data Publishing Group<br/>
          <strong>Feedback & Corrections:</strong> We welcome scientific feedback, data updates, and peer recommendations to continuously refine our portion algorithms.
        </p>
      </div>
    </main>

    <footer style="border-top: 1px solid var(--border-color); padding: 2rem 0; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
      <div class="container">
        <p>© 2026 NutriVisual. All rights reserved. <a href="/blog/" style="color: var(--accent-green);">Blog</a> | <a href="/terms/" style="color: var(--accent-green);">Terms</a> | <a href="/about/" style="color: var(--accent-green);">About</a> | <a href="/contact/" style="color: var(--accent-green);">Contact</a> | <button type="button" onclick="window.openCookieConsent && window.openCookieConsent()" style="background: none; border: none; color: var(--accent-green); cursor: pointer; text-decoration: underline; font-size: inherit; font-family: inherit; padding: 0;">Cookie Settings</button></p>
      </div>
    </footer>

    <CookieConsent />

    <script is:inline>
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const text = document.getElementById('theme-text');
        function syncUI(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
          if (icon && text) {
            icon.textContent = theme === 'light' ? '☀️' : '🌙';
            text.textContent = theme === 'light' ? 'Light' : 'Dark';
          }
        }
        syncUI(localStorage.getItem('theme') || 'light');
        if (btn) btn.onclick = () => syncUI(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      }
      function initMobileMenu() { const menuBtn = document.getElementById("mobile-menu-btn"); const nav = document.getElementById("header-nav"); if (menuBtn && nav) { menuBtn.onclick = () => { nav.classList.toggle("open"); menuBtn.textContent = nav.classList.contains("open") ? "✕" : "☰"; }; } } initThemeToggle(); initMobileMenu();
    </script>
  </body>
</html>
