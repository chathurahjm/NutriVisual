---
import '../styles/global.css';
import NutriVisualApp from '../components/NutriVisualApp.jsx';
import { buildWebApplicationSchema } from '../utils/schemaBuilder';

import posts from '../data/posts.json';

const title = "Visual Nutrition Guide & Food Portion Visualizer | NutriVisual";
const description = "Visual nutrition guide & food portion visualizer. Interactive macro comparison chart, nutrient density chart, satiety index food list, calorie density visualizer, and volume eating foods.";
const canonicalUrl = "https://nutrivisual.com/";
const webAppSchema = buildWebApplicationSchema(canonicalUrl);

const featuredBlogs = [
  {
    slug: "stomach-digestion-speed",
    title: "The Stomach Timeline: How Fast Do Different Foods Actually Digest?",
    subtitle: "Discover how fast liquids, simple carbs, complex carbs, proteins, and healthy fats digest in the stomach, and how to structure meals for long-lasting energy.",
    category: "Metabolic Health",
    date: "July 21, 2026",
    readTime: "6 min read"
  },
  posts[0],
  posts[1]
];

const featuredSwaps = [
  { path: '/swap/avocado-vs-olive-oil/', title: 'Avocado vs. Olive Oil', subtitle: 'Whole food fiber vs. concentrated polyphenols.', icon: '🥑 vs 🫒', tag: 'Healthy Fats' },
  { path: '/swap/atlantic-salmon-vs-chicken-breast/', title: 'Wild Salmon vs. Chicken Breast', subtitle: 'EPA/DHA omega-3 vs. ultra-lean protein.', icon: '🐟 vs 🍗', tag: 'High Protein' },
  { path: '/swap/matcha-vs-spirulina/', title: 'Matcha vs. Spirulina', subtitle: 'L-Theanine & EGCG vs. phycocyanin & B-vitamins.', icon: '🍵 vs 🧪', tag: 'Antioxidants' },
  { path: '/swap/blueberries-vs-dark-chocolate/', title: 'Blueberries vs. Dark Chocolate', subtitle: 'Anthocyanins vs. flavanols & magnesium.', icon: '🫐 vs 🍫', tag: 'Flavonoids' },
  { path: '/swap/broccoli-vs-spinach/', title: 'Broccoli vs. Spinach', subtitle: 'Sulforaphane vs. iron, lutein, & folate.', icon: '🥦 vs 🥬', tag: 'Micronutrients' },
  { path: '/swap/tofu-vs-tempeh/', title: 'Tofu vs. Tempeh', subtitle: 'Isoflavones vs. gut-friendly fermented protein.', icon: '🫘 vs 🧀', tag: 'Plant Protein' }
];
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8MPE6XWC1E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8MPE6XWC1E');
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD Structured Data for SEO -->
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <!-- Early Theme Script to prevent flash -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <!-- Top Navigation Header -->
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-main);">
          <span style="font-size: 1.6rem;">🥑</span>
          <span style="font-weight: 700; font-size: 1.3rem; letter-spacing: -0.5px;">Nutri<span style="color: var(--accent-green);">Visual</span></span>
        </a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">☰</button>
        <nav class="header-nav" id="header-nav">
          <a href="/swap/" style="color: var(--accent-green); font-weight: 700;">🔄 Food Swaps</a>
          <a href="/blog/">Blog</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/disclaimer/">Disclaimer</a>
          <button id="theme-toggle" aria-label="Toggle theme" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem; font-weight: 600; box-shadow: var(--shadow-card); transition: all 0.2s ease;">
            <span id="theme-icon">☀️</span> <span id="theme-text">Light</span>
          </button>
        </nav>
      </div>
    </header>

    <!-- Main Container -->
    <main class="container" style="padding-top: 2.5rem; padding-bottom: 5rem;">
      {/* Hero Header */}
      <div style="text-align: center; max-width: 780px; margin: 0 auto 3rem auto;">
        <h1 class="hero-title">
          Visual Nutrition Guide & <span style="color: var(--accent-green);">Food Portion Visualizer</span>
        </h1>
        <p style="color: var(--text-muted); font-size: 1.1rem;">
          Interactive food portion visualizer, macro comparison charts, nutrient density rankings, satiety index food lists, and volume eating calorie density metrics.
        </p>
      </div>

      {/* Astro Island: Interactive NutriVisual React App */}
      <NutriVisualApp client:load />

      {/* Interactive Food Swaps & Comparisons Showcase */}
      <section id="swaps" style="margin-top: 5rem; padding: 3rem 0; border-top: 1px solid var(--border-color);">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
          <div>
            <span style="display: inline-block; background-color: var(--accent-green-glow); color: var(--accent-green); font-size: 0.78rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 6px; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.5px;">
              Smart Nutritional Alternatives
            </span>
            <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin: 0;">
              🔄 Popular Food Swaps & Side-by-Side Comparisons
            </h2>
          </div>
          <a href="/swap/" style="color: var(--accent-green); font-weight: 700; text-decoration: none; font-size: 0.95rem; display: flex; align-items: center; gap: 0.3rem;">
            Explore All 25+ Food Swaps →
          </a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
          {featuredSwaps.map(swap => (
            <a href={swap.path} class="glass-card" style="padding: 1.5rem; text-decoration: none; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.2s ease;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                  <span style="font-size: 1.5rem;">{swap.icon}</span>
                  <span style="font-size: 0.72rem; font-weight: 700; color: var(--accent-green); background: var(--accent-green-glow); padding: 0.2rem 0.55rem; border-radius: 12px; text-transform: uppercase;">
                    {swap.tag}
                  </span>
                </div>
                <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.4rem;">
                  {swap.title}
                </h3>
                <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.45; margin: 0;">
                  {swap.subtitle}
                </p>
              </div>
              <div style="margin-top: 1.25rem; font-size: 0.85rem; font-weight: 700; color: var(--accent-green); display: flex; align-items: center; gap: 0.3rem;">
                Compare Macros & Bioavailability →
              </div>
            </a>
          ))}
        </div>
      </section>

      {/* Pre-rendered Longevity Science Articles */}
      <section id="science" style="margin-top: 6rem;">
        <h2 style="font-size: 1.8rem; font-weight: 700; margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
          🧪 Essential Longevity Micronutrients
        </h2>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
          <div class="glass-card" style="padding: 1.75rem;">
            <div style="fontSize: 1.8rem; margin-bottom: 0.5rem;">🥑</div>
            <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--accent-green); margin-bottom: 0.75rem;">
              Magnesium & Cardiovascular Longevity
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem;">
              Magnesium acts as a co-factor in over 300 enzymatic reactions, supporting arterial flexibility, ATP cellular energy production, and deep sleep architecture.
            </p>
          </div>

          <div class="glass-card" style="padding: 1.75rem;">
            <div style="fontSize: 1.8rem; margin-bottom: 0.5rem;">🐟</div>
            <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--accent-green); margin-bottom: 0.75rem;">
              Omega-3 Index (EPA & DHA)
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem;">
              Long-chain omega-3 fatty acids from wild seafood decrease systemic inflammatory biomarkers (hs-CRP) and preserve cognitive brain volume during aging.
            </p>
          </div>

          <div class="glass-card" style="padding: 1.75rem;">
            <div style="fontSize: 1.8rem; margin-bottom: 0.5rem;">🥦</div>
            <h3 style="font-size: 1.25rem; font-weight: 600; color: var(--accent-green); margin-bottom: 0.75rem;">
              Sulforaphane & Nrf2 Activation
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem;">
              Cruciferous vegetables release sulforaphane, a powerful phytochemical compound that triggers Phase-2 liver detoxification enzymes and protects DNA from oxidative stress.
            </p>
          </div>
        </div>
      </section>

      <!-- Latest Science Articles (Blog) -->
      <section id="blog" style="margin-top: 6rem; margin-bottom: 4rem;">
        <h2 style="font-size: 1.8rem; font-weight: 700; margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
          📚 Latest Nutrition Science Insights
        </h2>

        <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;">
          <div class="glass-card" style="padding: 2rem; display: flex; flex-wrap: wrap; gap: 2rem; align-items: center; justify-content: space-between;">
            <div style="flex: 1 1 450px;">
              <span style="display: inline-block; background-color: var(--accent-green-glow); color: var(--accent-green); font-size: 0.78rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 6px; margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">
                Gastric Emptying & Satiety
              </span>
              <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--text-main);">
                The Stomach Timeline: How Fast Do Different Foods Actually Digest?
              </h3>
              <p style="color: var(--text-muted); font-size: 0.98rem; margin-bottom: 1.5rem; line-height: 1.6;">
                Learn how liquids, simple carbs, complex carbs, proteins, and healthy fats digest in your stomach. Try our interactive visualizer showing real-time emptying speeds to design meals for sustained, all-day cognitive energy.
              </p>
              <a href="/blog/stomach-digestion-speed/" style="display: inline-block; background-color: var(--accent-green); color: white; padding: 0.65rem 1.35rem; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 0.9rem; transition: opacity 0.2s ease;">
                Read Article & Run Simulator →
              </a>
            </div>
            <div style="flex: 1 1 200px; display: flex; justify-content: center; align-items: center;">
              <!-- Mini Graphic of Stomachs -->
              <div style="background: var(--bg-surface); padding: 1.5rem; border-radius: 16px; border: 1px solid var(--border-color); width: 100%; max-width: 260px; text-align: center;">
                <span style="font-size: 3rem;">🏁</span>
                <div style="font-weight: 700; font-size: 0.9rem; margin-top: 0.5rem; color: var(--text-main);">Digestion Speed Race</div>
                <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">Interactive Simulator Included</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Featured Blogs Section -->
      <section style="padding: 4rem 0; border-top: 1px solid var(--border-color);">
        <div style="max-width: 1000px; margin: 0 auto;">
          <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
            <div>
              <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem; letter-spacing: -0.5px;">
                Top Science & Longevity Insights
              </h2>
              <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0;">
                Evidence-based guides to metabolic performance, portion density, and cellular wellness.
              </p>
            </div>
            <a href="/blog/" style="color: var(--accent-green); font-weight: 700; text-decoration: none; font-size: 0.9rem; display: flex; align-items: center; gap: 0.25rem;">
              View All Articles →
            </a>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
            {featuredBlogs.map(blog => (
              <a href={`/blog/${blog.slug}/`} style="text-decoration: none; display: flex; flex-direction: column;" class="glass-card">
                <div style="padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between; height: 100%;">
                  <div>
                    <span style="display: inline-block; background-color: var(--accent-green-glow); color: var(--accent-green); font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 4px; margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">
                      {blog.category}
                    </span>
                    <h3 style="font-size: 1.15rem; font-weight: 700; line-height: 1.35; margin-bottom: 0.5rem; color: var(--text-main);">
                      {blog.title}
                    </h3>
                    <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.45; margin-bottom: 1.25rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                      {blog.subtitle}
                    </p>
                  </div>
                  <div style="font-size: 0.75rem; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 0.75rem; display: flex; justify-content: space-between;">
                    <span>{blog.date}</span>
                    <span>{blog.readTime}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer style="border-top: 1px solid var(--border-color); padding: 2.5rem 0; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
      <div class="container">
        <p style="margin-bottom: 0.75rem;">© 2026 NutriVisual. Visual nutrition and longevity reference engine.</p>
        <div style="display: flex; justify-content: center; gap: 1.25rem; flex-wrap: wrap;">
          <a href="/swap/" style="color: var(--accent-green); text-decoration: none; font-weight: 600;">Food Swaps</a>
          <a href="/about/" style="color: var(--accent-green); text-decoration: none;">About Us</a>
          <a href="/privacy/" style="color: var(--accent-green); text-decoration: none;">Privacy Policy</a>
          <a href="/terms/" style="color: var(--accent-green); text-decoration: none;">Terms of Service</a>
          <a href="/disclaimer/" style="color: var(--accent-green); text-decoration: none;">Medical Disclaimer</a>
          <a href="/blog/" style="color: var(--accent-green); text-decoration: none;">Blog</a>
          <a href="/contact/" style="color: var(--accent-green); text-decoration: none;">Contact Us</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const text = document.getElementById('theme-text');

        function syncUI(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
          if (icon && text) {
            icon.textContent = theme === 'light' ? '☀️' : '🌙';
            text.textContent = theme === 'light' ? 'Light' : 'Dark';
          }
        }

        const currentTheme = localStorage.getItem('theme') || 'light';
        syncUI(currentTheme);

        if (btn) {
          btn.onclick = () => {
            const now = document.documentElement.getAttribute('data-theme') || 'light';
            const next = now === 'dark' ? 'light' : 'dark';
            syncUI(next);
          };
        }
      }

      function initMobileMenu() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const nav = document.getElementById('header-nav');
        if (menuBtn && nav) {
          menuBtn.onclick = () => {
            nav.classList.toggle('open');
            menuBtn.textContent = nav.classList.contains('open') ? '✕' : '☰';
          };
        }
      }

      initThemeToggle();
      initMobileMenu();
    </script>
  </body>
</html>
