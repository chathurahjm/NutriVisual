---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { buildOrganizationSchema, buildBreadcrumbSchema } from '../utils/schemaBuilder';

const title = "Contact Us - NutriVisual";
const description = "Get in touch with the NutriVisual team for inquiries, feedback, or data partnerships.";
const canonicalUrl = "https://nutrivisual.com/contact/";

const orgSchema = buildOrganizationSchema();
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://nutrivisual.com/' },
  { name: 'Contact Us', url: canonicalUrl }
]);
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8MPE6XWC1E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8MPE6XWC1E');
    </script>
    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y14bl1l18k");
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Rich Snippet Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-main);">
          <span style="font-size: 1.6rem;">🥑</span>
          <span style="font-weight: 700; font-size: 1.3rem; letter-spacing: -0.5px;">Nutri<span style="color: var(--accent-green);">Visual</span></span>
        </a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">☰</button>
        <nav class="header-nav" id="header-nav">
          <a href="/" style="color: var(--accent-green); font-weight: 600;">← Home</a>
          <a href="/swap/">Food Swaps</a>
          <a href="/blog/">Blog</a>
          <button id="theme-toggle" aria-label="Toggle theme" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">
            <span id="theme-icon">☀️</span> <span id="theme-text">Light</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="container" style="padding-top: 3rem; padding-bottom: 5rem; max-width: 700px;">
      <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main);">Contact Us</h1>
      <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 2.5rem;">
        Have a question, feedback, or a data correction suggestion? We'd love to hear from you.
      </p>

      <div class="glass-card" style="padding: 2.5rem;">
        <form onsubmit="event.preventDefault(); alert('Thank you! Your message has been received. Our editorial team will reply within 24-48 business hours.');" style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div>
            <label style="display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem; color: var(--text-main);">Your Full Name</label>
            <input type="text" required placeholder="Dr. Jane Doe" style="width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-surface); color: var(--text-main); font-size: 0.95rem;" />
          </div>

          <div>
            <label style="display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem; color: var(--text-main);">Email Address</label>
            <input type="email" required placeholder="jane@example.com" style="width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-surface); color: var(--text-main); font-size: 0.95rem;" />
          </div>

          <div>
            <label style="display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem; color: var(--text-main);">Inquiry Category</label>
            <select style="width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-surface); color: var(--text-main); font-size: 0.95rem;">
              <option value="general">General Feedback & Suggestions</option>
              <option value="data">USDA Data Correction / Nutritional Update</option>
              <option value="press">Press & Media Inquiries</option>
              <option value="partnership">Data Licensing & Educational Integration</option>
            </select>
          </div>

          <div>
            <label style="display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem; color: var(--text-main);">Message Details</label>
            <textarea required rows="5" placeholder="Please provide specific details regarding your question or data feedback..." style="width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-surface); color: var(--text-main); font-size: 0.95rem; resize: vertical;"></textarea>
          </div>

          <button type="submit" style="background: var(--accent-green); color: #fff; border: none; padding: 0.85rem; border-radius: 8px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: opacity 0.2s ease;">
            Send Inquiry
          </button>
        </form>

        <div style="margin-top: 2rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem; font-size: 0.9rem; color: var(--text-muted); display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
          <div>
            <strong style="color: var(--text-main);">Direct Email:</strong><br/>
            chathurahjm@gmail.com
          </div>
          <div>
            <strong style="color: var(--text-main);">Response SLA:</strong><br/>
            24–48 Business Hours
          </div>
          <div>
            <strong style="color: var(--text-main);">Publisher Organization:</strong><br/>
            NutriVisual Publishing
          </div>
        </div>
      </div>
    </main>

    <footer style="border-top: 1px solid var(--border-color); padding: 2rem 0; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
      <div class="container">
        <p>© 2026 NutriVisual. All rights reserved. <a href="/blog/" style="color: var(--accent-green);">Blog</a> | <a href="/terms/" style="color: var(--accent-green);">Terms</a> | <a href="/contact/" style="color: var(--accent-green);">Contact</a> | <button type="button" onclick="window.openCookieConsent && window.openCookieConsent()" style="background: none; border: none; color: var(--accent-green); cursor: pointer; text-decoration: underline; font-size: inherit; font-family: inherit; padding: 0;">Cookie Settings</button></p>
      </div>
    </footer>

    <CookieConsent />

    <script is:inline>
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const text = document.getElementById('theme-text');
        function syncUI(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
          if (icon && text) {
            icon.textContent = theme === 'light' ? '☀️' : '🌙';
            text.textContent = theme === 'light' ? 'Light' : 'Dark';
          }
        }
        syncUI(localStorage.getItem('theme') || 'light');
        if (btn) btn.onclick = () => syncUI(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      }
      function initMobileMenu() { const menuBtn = document.getElementById("mobile-menu-btn"); const nav = document.getElementById("header-nav"); if (menuBtn && nav) { menuBtn.onclick = () => { nav.classList.toggle("open"); menuBtn.textContent = nav.classList.contains("open") ? "✕" : "☰"; }; } } initThemeToggle(); initMobileMenu();
    </script>
  </body>
</html>
