---
import '../../styles/global.css';
import CookieConsent from '../../components/CookieConsent.astro';
import foodsData from '../../data/foods.json';
import { buildNutritionProductSchema, buildBreadcrumbSchema, buildFAQPageSchema } from '../../utils/schemaBuilder';

export async function getStaticPaths() {
  return foodsData.map((food) => ({
    params: { id: food.id },
    props: { food },
  }));
}

const { food } = Astro.props;

// Quick-win target custom metadata overrides for high-impression search terms
const foodMetaOverrides: Record<string, { title: string; description: string }> = {
  'goji-berries': {
    title: 'Goji Berries Macros, Calories & Nutrition per 100g | NutriVisual',
    description: 'Detailed goji berries macros & nutrition facts: calories, carbs, fiber, protein, and fat per 100g serving. Interactive visual portion size calculator.'
  },
  'carrots': {
    title: 'Carrot Nutrition Facts, Calories & Macros per 100g | NutriVisual',
    description: 'Carrot nutrition facts, calories, and macros per 100g raw & cooked. Fiber, vitamin A, sugar breakdown, and interactive visual portion size guide.'
  },
  'sweet-potato': {
    title: 'Sweet Potato Calories, Macros & Calorie Content | NutriVisual',
    description: 'Calorie content of sweet potato & macro breakdown: calories per 100g, fiber, net carbs, potassium, and visual portion size comparison charts.'
  },
  'macadamia-nuts': {
    title: 'Macadamia Nuts Calories, Fat & Nutrition per 100g | NutriVisual',
    description: 'Macadamia nuts calories & macro breakdown: 718 kcal per 100g, monounsaturated fats, protein, and visual portion size calculator.'
  },
  'pumpkin-seeds': {
    title: 'Pumpkin Seeds Calories, Protein & Nutrition Facts | NutriVisual',
    description: 'Calories in pumpkin seeds & macro breakdown: protein per serving, zinc, magnesium, healthy fats, and interactive portion visualizer.'
  },
  'beef-liver': {
    title: 'Beef Liver Nutrition Facts, Macros & Calories per 100g | NutriVisual',
    description: 'Grass-fed beef liver nutrition facts, calories, protein, micronutrients, iron, vitamin A, and visual portion size breakdown.'
  }
};

const title = foodMetaOverrides[food.id]?.title || `${food.name} Nutrition Facts, Calories & Macros | NutriVisual`;
const description = foodMetaOverrides[food.id]?.description || `${food.name} nutrition facts, calories & macros: ${food.calories} kcal, ${food.macros.protein}g protein, ${food.macros.carbs}g carbs, ${food.macros.fat}g fat per 100g. Visual portion size guide.`;
const canonicalUrl = `https://nutrivisual.com/food/${food.id}/`;

const nutritionSchema = buildNutritionProductSchema(food, canonicalUrl);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: 'https://nutrivisual.com/' },
  { name: 'Food Database', url: 'https://nutrivisual.com/#foods' },
  { name: food.name, url: canonicalUrl }
]);
const faqSchema = buildFAQPageSchema([
  {
    question: `How many calories are in 100g of ${food.name}?`,
    answer: `100 grams of ${food.name} contains approximately ${food.calories} calories, ${food.macros.protein}g of protein, ${food.macros.carbs}g of carbohydrates, and ${food.macros.fat}g of fat.`
  },
  {
    question: `What are the macros for ${food.name}?`,
    answer: `Per 100g serving, ${food.name} provides ${food.macros.protein}g protein, ${food.macros.carbs}g carbs (${food.macros.fiber}g fiber), and ${food.macros.fat}g fat for a total of ${food.calories} kcal.`
  },
  {
    question: `Is ${food.name} high in protein?`,
    answer: `${food.name} provides ${food.macros.protein}g of protein per 100g serving, making it a key component of visual macro tracking on NutriVisual.`
  }
]);

// Find 3 related items in the same category
const relatedFoods = foodsData.filter((f) => f.category === food.category && f.id !== food.id).slice(0, 3);

// Popular predefined swap pairs for internal link silos
import { popularPairs } from '../../utils/popularPairs';

// Match pairs containing food.id
let relevantSwaps = popularPairs
  .filter(([id1, id2]) => id1 === food.id || id2 === food.id)
  .map(([id1, id2]) => {
    const otherId = id1 === food.id ? id2 : id1;
    const otherFood = foodsData.find(f => f.id === otherId);
    return {
      pairSlug: `${id1}-vs-${id2}`,
      title: `${food.name} vs ${otherFood?.name || otherId}`,
      otherName: otherFood?.name || otherId,
      otherImage: otherFood?.image || food.image,
      otherCalories: otherFood?.calories || 0
    };
  });

// Fallback: If no direct popular swap pair found, create 3 cross-category swaps with top items
if (relevantSwaps.length === 0) {
  const fallbackFoods = foodsData.filter(f => f.id !== food.id && (f.category === food.category || f.calories > 100)).slice(0, 3);
  relevantSwaps = fallbackFoods.map(f => ({
    pairSlug: `${food.id}-vs-${f.id}`,
    title: `${food.name} vs ${f.name}`,
    otherName: f.name,
    otherImage: f.image,
    otherCalories: f.calories
  }));
}
relevantSwaps = relevantSwaps.slice(0, 4);

// Dynamic Portion Equivalents
const targetCal = food.calories;
const comparisons = [
  { id: 'sliced-avocado', name: 'Sliced Avocado', defaultRef: 'raw-walnuts' },
  { id: 'grilled-chicken-breast', name: 'Grilled Chicken Breast', defaultRef: 'wild-atlantic-salmon' },
  { id: 'steamed-organic-broccoli', name: 'Steamed Broccoli', defaultRef: 'baby-spinach-leaves' }
].map(ref => {
  let finalId = ref.id;
  // Prevent comparing the food to itself
  if (food.id === ref.id || food.id.includes(ref.id) || ref.id.includes(food.id)) {
    finalId = ref.defaultRef;
  }
  const matched = foodsData.find(f => f.id === finalId);
  if (!matched) return null;
  const grams = Math.round((targetCal / matched.calories) * 100);
  return {
    name: matched.name,
    image: matched.image,
    grams: grams
  };
}).filter(Boolean);
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8MPE6XWC1E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8MPE6XWC1E');
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={food.image} />
    <meta property="og:type" content="article" />

    <!-- Google Rich Snippet Schemas (Nutrition, Breadcrumbs, FAQs) -->
    <script type="application/ld+json" set:html={JSON.stringify(nutritionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Early Theme Script to prevent flash -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    {/* Navigation */}
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none; color: var(--text-main);">
          <span style="font-size: 1.6rem;">🥑</span>
          <span style="font-weight: 700; font-size: 1.3rem; letter-spacing: -0.5px;">Nutri<span style="color: var(--accent-green);">Visual</span></span>
        </a>
        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Toggle menu">☰</button>
        <nav class="header-nav" id="header-nav">
          <a href="/" style="color: var(--accent-green); font-weight: 600;">← Home</a>
          <a href="/swap/">Food Swaps</a>
          <a href="/blog/">Blog</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy</a>
          <button id="theme-toggle" aria-label="Toggle theme" style="background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.45rem 0.9rem; border-radius: 20px; cursor: pointer; font-size: 0.85rem; display: flex; align-items: center; gap: 0.4rem; font-weight: 600; box-shadow: var(--shadow-card); transition: all 0.2s ease;">
            <span id="theme-icon">☀️</span> <span id="theme-text">Light</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="container" style="padding-top: 2.5rem; padding-bottom: 5rem;">
      {/* Breadcrumb */}
      <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem;">
        <a href="/" style="color: var(--text-muted); text-decoration: none;">Home</a> / <span style="color: var(--text-muted);">{food.category}</span> / <span style="color: var(--accent-green);">{food.name}</span>
      </div>

      {/* Main Showcase Hero Card */}
      <div class="glass-card" style="padding: 2.5rem; margin-bottom: 3rem;">
        <div class="layout-food-hero">
          <div style="border-radius: 16px; overflow: hidden; height: 320px; position: relative;">
            <img src={food.image} alt={food.name} style="width: 100%; height: 100%; object-fit: cover;" />
            <span style="position: absolute; top: 16px; left: 16px; background-color: var(--bg-header); padding: 0.4rem 0.85rem; border-radius: 20px; font-size: 0.85rem; color: var(--accent-green); font-weight: 600; backdrop-filter: blur(8px);">
              {food.category}
            </span>
          </div>

          <div>
            <h1 style="font-size: 2.4rem; font-weight: 700; margin-bottom: 0.5rem; line-height: 1.2;">{food.name}</h1>
            <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 1.75rem;">
              Lab-tested reference nutrition values for a standard <strong>100g serving</strong>.
            </p>

            {/* Macro Cards Grid */}
            <div class="layout-food-macros">
              <div style="background-color: var(--bg-surface); padding: 1rem; border-radius: 10px; text-align: center; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--text-muted);">Calories</div>
                <div style="font-size: 1.3rem; font-weight: 700; color: var(--text-main); font-family: var(--font-mono);">{food.calories} kcal</div>
              </div>
              <div style="background-color: var(--bg-surface); padding: 1rem; border-radius: 10px; text-align: center; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--text-muted);">Fat</div>
                <div style="font-size: 1.3rem; font-weight: 700; color: var(--accent-green); font-family: var(--font-mono);">{food.macros.fat}g</div>
              </div>
              <div style="background-color: var(--bg-surface); padding: 1rem; border-radius: 10px; text-align: center; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--text-muted);">Carbs</div>
                <div style="font-size: 1.3rem; font-weight: 700; color: var(--accent-cyan); font-family: var(--font-mono);">{food.macros.carbs}g</div>
              </div>
              <div style="background-color: var(--bg-surface); padding: 1rem; border-radius: 10px; text-align: center; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--text-muted);">Protein</div>
                <div style="font-size: 1.3rem; font-weight: 700; color: var(--accent-amber); font-family: var(--font-mono);">{food.macros.protein}g</div>
              </div>
            </div>

            {/* Micronutrient Badges */}
            <h3 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-main);">
              🧬 Micronutrients & Longevity Highlights
            </h3>
            <div style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
              {Object.entries(food.micros).map(([key, val]) => (
                <div style="background-color: var(--bg-surface); border: 1px solid var(--border-color); padding: 0.45rem 0.9rem; border-radius: 8px; font-size: 0.85rem;">
                  <span style="color: var(--text-muted); text-transform: capitalize;">{key}:</span>{' '}
                  <strong style="color: var(--accent-green); font-family: var(--font-mono);">{val}</strong>
                </div>
              ))}
              {food.tags.map((tag) => (
                <div style="background-color: var(--accent-green-glow); border: 1px solid var(--accent-green); color: var(--accent-green); padding: 0.45rem 0.9rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600;">
                  ✓ {tag}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      {/* Featured Snippet Quick Summary Box */}
      <div class="glass-card" style="padding: 2rem; margin-bottom: 3rem; border-left: 4px solid var(--accent-green);">
        <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
          📋 Quick Summary: {food.name} Nutrition Facts (Per 100g)
        </h2>
        <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 1rem;">
          A standard 100g serving of <strong>{food.name}</strong> provides <strong>{food.calories} calories</strong>, <strong>{food.macros.protein}g protein</strong>, <strong>{food.macros.carbs}g carbs</strong> ({food.macros.fiber}g fiber), and <strong>{food.macros.fat}g fat</strong>.
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; font-size: 0.9rem;">
          <div style="background: var(--bg-surface); padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
            <strong style="color: var(--text-main);">Caloric Density:</strong> <span style="color: var(--accent-green); font-weight: 600;">{food.calories} kcal / 100g</span>
          </div>
          <div style="background: var(--bg-surface); padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
            <strong style="color: var(--text-main);">Protein Content:</strong> <span style="color: var(--accent-amber); font-weight: 600;">{food.macros.protein}g</span>
          </div>
          <div style="background: var(--bg-surface); padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
            <strong style="color: var(--text-main);">Carbohydrates:</strong> <span style="color: var(--accent-cyan); font-weight: 600;">{food.macros.carbs}g</span>
          </div>
          <div style="background: var(--bg-surface); padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
            <strong style="color: var(--text-main);">Dietary Fat:</strong> <span style="color: var(--accent-green); font-weight: 600;">{food.macros.fat}g</span>
          </div>
        </div>
      </div>

      {/* NEW: Health Benefits ("Good For") Section */}
      {food.benefits && food.benefits.length > 0 && (
        <section class="glass-card" style="padding: 2rem; margin-bottom: 3rem;">
          <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
            🛡️ Primary Health Benefits & Target Functions
          </h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;">
            {food.benefits.map((benefit) => (
              <div style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1.25rem; border-radius: 12px; display: flex; align-items: flex-start; gap: 0.75rem; transition: transform 0.2s ease, border-color 0.2s ease;">
                <div style="font-size: 1.5rem; background: var(--accent-green-glow); color: var(--accent-green); padding: 0.3rem 0.5rem; border-radius: 8px; line-height: 1;">✓</div>
                <div>
                  <h4 style="font-weight: 700; color: var(--text-main); font-size: 1rem; margin: 0 0 0.25rem 0;">{benefit}</h4>
                  <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0; line-height: 1.4;">Clinically backed nutritional pathway for longevity promotion.</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* NEW: Comprehensive Scientific & Culinary Profile Guide */}
      <section class="glass-card" style="padding: 2.5rem; margin-bottom: 3rem;">
        <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1.25rem; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
          📖 Clinical & Nutritional Analysis: {food.name}
        </h2>
        <div style="display: flex; flex-direction: column; gap: 1.5rem; color: var(--text-main); line-height: 1.7; font-size: 0.98rem;">
          <div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--accent-green); margin-bottom: 0.4rem;">
              1. Caloric Density & Satiety Response
            </h3>
            <p style="color: var(--text-muted); margin: 0;">
              Providing <strong>{food.calories} kcal per 100g serving</strong>, {food.name} sits in the <strong>{food.calories < 100 ? 'Low Calorie Density (High Volume)' : food.calories < 250 ? 'Moderate Energy Density' : 'High Energy Density'}</strong> spectrum of whole foods. 
              {food.macros.protein > 15 ? ` With ${food.macros.protein}g of protein per 100g, it triggers strong peptide YY (PYY) and CCK satiety signaling to protect against premature hunger.` : ` Containing ${food.macros.fiber}g of dietary fiber and ${food.macros.fat}g of healthy lipids, it provides steady, sustained energy release.`}
            </p>
          </div>

          <div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--accent-green); margin-bottom: 0.4rem;">
              2. Micronutrient Synergies & Metabolic Integration
            </h3>
            <p style="color: var(--text-muted); margin: 0;">
              The micronutrient matrix of {food.name} is rich in {Object.keys(food.micros).join(', ')}. These essential minerals and vitamins act as catalytic co-factors for cellular mitochondrial energy production, enzymatic antioxidant defenses, and systemic metabolic regulation.
            </p>
          </div>

          <div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--accent-green); margin-bottom: 0.4rem;">
              3. Preparation & Bioavailability Guidance
            </h3>
            <p style="color: var(--text-muted); margin: 0;">
              To maximize the nutritional value of {food.name}, avoid over-exposure to extreme dry heat that can oxidize lipids or degrade water-soluble vitamins. {food.macros.fat > 5 ? 'Pairing with acid (lemon, vinegar) enhances palatability and digestive enzyme stimulation.' : 'Combining with a light healthy fat source (like olive oil or avocado) facilitates the absorption of fat-soluble antioxidants.'}
            </p>
          </div>
        </div>
      </section>

      {/* NEW: Portion Equivalents Comparison Section */}
      <section class="glass-card" style="padding: 2.5rem; margin-bottom: 3rem;">
        <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          ⚖️ Visual Calorie portion Equivalents
        </h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.75rem;">
          A 100g portion of <strong>{food.name}</strong> ({food.calories} kcal) is equivalent in energy density to:
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;">
          {comparisons.map((comp) => (
            <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s ease;">
              <div style="height: 150px; overflow: hidden; position: relative;">
                <img src={comp.image} alt={comp.name} style="width: 100%; height: 100%; object-fit: cover;" />
                <div style="position: absolute; bottom: 12px; left: 12px; background: rgba(0, 0, 0, 0.7); color: #fff; padding: 0.35rem 0.75rem; border-radius: 20px; font-weight: 700; font-size: 0.9rem; font-family: var(--font-mono); backdrop-filter: blur(4px);">
                  {comp.grams} grams
                </div>
              </div>
              <div style="padding: 1.25rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                  <h4 style="font-weight: 700; color: var(--text-main); font-size: 1.05rem; margin: 0 0 0.25rem 0;">{comp.name}</h4>
                  <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">Equivalent portion matching the exact calorie target of {food.calories} kcal.</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* Internal Link Silo: Popular Food Swaps Section */}
      {relevantSwaps.length > 0 && (
        <section class="glass-card" style="padding: 2.5rem; margin-bottom: 3rem;">
          <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
            🔄 Popular Food Swaps & Comparisons for {food.name}
          </h2>
          <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
            Compare calorie density, protein ratios, and volume eating swap metrics for <strong>{food.name}</strong>:
          </p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
            {relevantSwaps.map((swap) => (
              <a href={`/swap/${swap.pairSlug}/`} style="text-decoration: none; color: inherit;">
                <div style="background: var(--bg-surface); border: 1px solid var(--border-color); padding: 1.25rem; border-radius: 12px; display: flex; align-items: center; gap: 1rem; transition: border-color 0.2s ease, transform 0.2s ease;">
                  <img src={swap.otherImage} alt={swap.title} style="width: 54px; height: 54px; border-radius: 8px; object-fit: cover;" />
                  <div>
                    <h3 style="font-weight: 700; font-size: 0.98rem; color: var(--accent-green); margin: 0 0 0.25rem 0;">{swap.title}</h3>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">Compare macros & portion swap ratio →</p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Frequently Asked Questions (FAQ) Section for SERPs & Voice Search */}
      <section class="glass-card" style="padding: 2.5rem; margin-bottom: 3rem;">
        <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          ❓ Frequently Asked Questions ({food.name})
        </h2>
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div style="background: var(--bg-surface); padding: 1.25rem; border-radius: 10px; border: 1px solid var(--border-color);">
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.5rem 0;">
              How many calories are in 100g of {food.name}?
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0; line-height: 1.5;">
              100 grams of {food.name} contains approximately <strong>{food.calories} calories</strong>, along with {food.macros.protein}g protein, {food.macros.carbs}g carbohydrates, and {food.macros.fat}g fat.
            </p>
          </div>
          <div style="background: var(--bg-surface); padding: 1.25rem; border-radius: 10px; border: 1px solid var(--border-color);">
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.5rem 0;">
              What are the macros for {food.name}?
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0; line-height: 1.5;">
              Per 100g serving, {food.name} provides <strong>{food.macros.protein}g protein</strong>, <strong>{food.macros.carbs}g carbs</strong> ({food.macros.fiber}g fiber), and <strong>{food.macros.fat}g fat</strong>.
            </p>
          </div>
          <div style="background: var(--bg-surface); padding: 1.25rem; border-radius: 10px; border: 1px solid var(--border-color);">
            <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.5rem 0;">
              Is {food.name} high in protein?
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0; line-height: 1.5;">
              {food.name} provides <strong>{food.macros.protein}g of protein per 100g serving</strong>, making it a valuable component of visual macro tracking on NutriVisual.
            </p>
          </div>
        </div>
      </section>

      {/* MOVE 4: Embeddable NutriVisual Card Widget */}
      <section class="glass-card" style="padding: 2rem; margin-bottom: 3rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
          <div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text-main); margin: 0 0 0.25rem 0; display: flex; align-items: center; gap: 0.5rem;">
              📋 Embed {food.name} Card on Your Blog or Site
            </h3>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin: 0;">
              Copy this interactive HTML widget snippet to embed live nutrition metrics on any food blog or article.
            </p>
          </div>
          <button
            id="copy-embed-btn"
            style="background: var(--accent-green); color: #ffffff; border: none; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 700; font-size: 0.85rem; cursor: pointer; transition: opacity 0.2s ease;"
          >
            Copy Embed Code 📋
          </button>
        </div>

        <textarea
          id="embed-code-textarea"
          readonly
          rows="3"
          style="width: 100%; padding: 0.75rem; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-surface); color: var(--text-muted); font-family: var(--font-mono); font-size: 0.8rem; resize: none;"
        >{`<iframe src="https://nutrivisual.web.app/food/${food.id}/" width="100%" height="450" style="border:1px solid #e2e8f0; border-radius:12px;" title="${food.name} Nutrition"></iframe>\n<p><a href="https://nutrivisual.web.app/food/${food.id}/">Powered by NutriVisual Engine</a></p>`}</textarea>
      </section>

      {/* Related Foods Section */}
      {relatedFoods.length > 0 && (
        <section style="margin-top: 4rem;">
          <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">
            🥦 Related Foods in {food.category}
          </h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
            {relatedFoods.map((rel) => (
              <a href={`/food/${rel.id}/`} style="text-decoration: none; color: inherit;">
                <div class="glass-card" style="padding: 1.25rem; display: flex; align-items: center; gap: 1rem; height: 100%;">
                  <img src={rel.image} alt={rel.name} style="width: 64px; height: 64px; border-radius: 10px; object-fit: cover;" />
                  <div>
                    <div style="font-weight: 600; font-size: 1rem; color: var(--text-main); margin-bottom: 0.25rem;">{rel.name}</div>
                    <div style="font-size: 0.8rem; color: var(--text-muted);">{rel.calories} kcal • {rel.macros.protein}g protein</div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>

    {/* Footer */}
    <footer style="border-top: 1px solid var(--border-color); padding: 2.5rem 0; text-align: center; color: var(--text-muted); font-size: 0.85rem;">
      <div class="container">
        <p style="margin-bottom: 0.75rem;">© 2026 NutriVisual. Visual nutrition and longevity reference engine.</p>
        <div style="display: flex; justify-content: center; gap: 1.25rem; flex-wrap: wrap;">
          <a href="/about/" style="color: var(--accent-green); text-decoration: none;">About Us</a>
          <a href="/privacy/" style="color: var(--accent-green); text-decoration: none;">Privacy Policy</a>
          <a href="/terms/" style="color: var(--accent-green); text-decoration: none;">Terms of Service</a>
          <a href="/disclaimer/" style="color: var(--accent-green); text-decoration: none;">Medical Disclaimer</a>
          <a href="/contact/" style="color: var(--accent-green); text-decoration: none;">Contact Us</a>
          <button type="button" onclick="window.openCookieConsent && window.openCookieConsent()" style="background: none; border: none; color: var(--accent-green); cursor: pointer; text-decoration: underline; font-size: inherit; font-family: inherit; padding: 0;">Cookie Settings</button>
        </div>
      </div>
    </footer>

    <CookieConsent />

    <script is:inline>
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        const icon = document.getElementById('theme-icon');
        const text = document.getElementById('theme-text');

        function syncUI(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
          if (icon && text) {
            icon.textContent = theme === 'light' ? '☀️' : '🌙';
            text.textContent = theme === 'light' ? 'Light' : 'Dark';
          }
        }

        const currentTheme = localStorage.getItem('theme') || 'light';
        syncUI(currentTheme);

        if (btn) {
          btn.onclick = () => {
            const now = document.documentElement.getAttribute('data-theme') || 'light';
            const next = now === 'dark' ? 'light' : 'dark';
            syncUI(next);
          };
        }
      }
      function initEmbedCopy() {
        const copyBtn = document.getElementById('copy-embed-btn');
        const textarea = document.getElementById('embed-code-textarea');
        if (copyBtn && textarea) {
          copyBtn.onclick = () => {
            textarea.select();
            navigator.clipboard.writeText(textarea.value);
            copyBtn.textContent = 'Copied! ✓';
            setTimeout(() => { copyBtn.textContent = 'Copy Embed Code 📋'; }, 2500);
          };
        }
      }
      function initMobileMenu() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const nav = document.getElementById('header-nav');
        if (menuBtn && nav) {
          menuBtn.onclick = () => {
            nav.classList.toggle('open');
            menuBtn.textContent = nav.classList.contains('open') ? '✕' : '☰';
          };
        }
      }
      initThemeToggle();
      initEmbedCopy();
      initMobileMenu();
    </script>
  </body>
</html>
